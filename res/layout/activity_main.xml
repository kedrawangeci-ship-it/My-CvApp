<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- PROFILE HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="#B0E0E6"
            android:elevation="4dp">

            <TextView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:gravity="center"
                android:text="👩‍💻"
                android:textSize="48sp"
                android:background="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="MY CURRICULUM VITAE"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="#234A6B"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Valeliekedra Wangeci"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#234A6B"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ICT Student | Future IT Professional"
                android:textSize="14sp"
                android:textColor="#234A6B"
                android:gravity="center"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ABOUT ME -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👋 ABOUT ME"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#4169A1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="I am an ICT student who enjoys learning about computers, programming and technology. I am hardworking, creative and willing to learn new skills. My goal is to become a skilled IT professional."
                android:textSize="16sp"
                android:textColor="#444444"
                android:lineSpacingExtra="5dp" />
        </LinearLayout>

        <!-- PERSONAL DETAILS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 PERSONAL DETAILS"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#4169A1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Name: Valeliekedra Wangeci\nCourse: ICT Technician Level 6\nInstitution: Kajiado National Polytechnic\nCareer: IT Technician"
                android:textSize="16sp"
                android:textColor="#444444"
                android:lineSpacingExtra="7dp" />
        </LinearLayout>

        <!-- EDUCATION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎓 EDUCATION"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#4169A1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="ICT Technician Level 6\nCurrently studying information technology and learning practical computer skills."
                android:textSize="16sp"
                android:textColor="#444444"
                android:lineSpacingExtra="5dp" />
        </LinearLayout>

        <!-- SKILLS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💻 MY TECHNICAL SKILLS"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#4169A1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HTML and Web Design"
                android:layout_marginTop="12dp"
                android:textSize="16sp" />

            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:progress="70"
                android:progressTint="#89CFF0"
                android:progressBackgroundTint="#E6E6FA" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Java Programming"
                android:layout_marginTop="12dp"
                android:textSize="16sp" />

            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:progress="55"
                android:progressTint="#89CFF0"
                android:progressBackgroundTint="#E6E6FA" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Android Studio"
                android:layout_marginTop="12dp"
                android:textSize="16sp" />

            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:progress="60"
                android:progressTint="#89CFF0"
                android:progressBackgroundTint="#E6E6FA" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Microsoft Word and Excel"
                android:layout_marginTop="12dp"
                android:textSize="16sp" />

            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:progress="75"
                android:progressTint="#89CFF0"
                android:progressBackgroundTint="#E6E6FA" />
        </LinearLayout>

        <!-- ACHIEVEMENTS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏆 MY ACHIEVEMENTS"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#4169A1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="✓ Learning programming\n\n✓ Designing web pages\n\n✓ Developing Android applications\n\n✓ Improving my computer skills"
                android:textSize="16sp"
                android:textColor="#444444" />
        </LinearLayout>

        <!-- PROJECTS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 MY PROJECTS"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#4169A1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="1. Personal CV App\nA simple application that displays my personal information.\n\n2. Fashion Website\nA website designed to display clothes and shoes.\n\n3. Number List App\nA basic Android application for adding and clearing numbers."
                android:textSize="16sp"
                android:textColor="#444444"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- HOBBIES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌟 MY HOBBIES"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#4169A1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="• Learning new things\n• Exploring technology\n• Listening to music\n• Being creative"
                android:textSize="16sp"
                android:textColor="#444444"
                android:lineSpacingExtra="5dp" />
        </LinearLayout>

        <!-- CAREER GOAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginTop="12dp"
            android:background="#CCCCFF"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚀 MY CAREER GOAL"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#333355" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="My dream is to gain more ICT knowledge, develop useful applications and become a successful IT professional."
                android:textSize="16sp"
                android:textColor="#333355" />
        </LinearLayout>

        <!-- CONTACT BUTTON -->
        <Button
            android:id="@+id/btnContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="CONTACT ME"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#234A6B"
            android:backgroundTint="#89CFF0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="20dp"
            android:text="Thank you for visiting my CV 💙"
            android:textSize="15sp"
            android:textColor="#555577" />

    </LinearLayout>
</ScrollView>